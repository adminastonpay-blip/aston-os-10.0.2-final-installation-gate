{
  "name": "aston-os-enterprise",
  "version": "10.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/check-repo.mjs",
    "test": "node --test tests/*.test.js",
    "dry-run": "npx --yes wrangler@latest deploy --dry-run --outdir dist",
    "dev": "npx --yes wrangler@latest dev",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "validate": "npm run check && npm test && npm run dry-run",
    "build": "npm run check"
  },
  "devDependencies": {
    "wrangler": "4.151.0"
  }
}
